{
  "name": "phlock-celebration-at-sea",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phc",
      "database_id": "9e1af854-0dd2-480e-8040-3796d0468c5e"
    }
  ],
  "triggers": {
    // Daily at 14:00 UTC (10am Eastern during DST, 9am otherwise): drip sends.
    "crons": ["0 14 * * *"]
  },
  "vars": {
    "ADMIN_EMAILS": "PTVacations@aol.com,dawn.turnertravel@gmail.com,Brent.beasley@cruiseplanners.com,brentb@cruisestoursandtravel.com",
    "SESSION_TTL_DAYS": "30",
    "MAIL_FROM": "Parrothead Day Cruise <noreply@parrotheadscruise.com>",
    "LEAD_NOTIFY_EMAILS": "PTVacations@aol.com,dawn.turnertravel@gmail.com,brentb@cruisestoursandtravel.com,brentb@cruiseshoppers.com",
    // Drip campaign (src/drip.js). Flip DRIP_ENABLED to "true" to go live.
    "DRIP_ENABLED": "false",
    "DRIP_FROM": "International Parrothead Day Cruise <sales@parrotheadscruise.com>",
    "DRIP_REPLY_TO": "PTVacations@aol.com,dawn.turnertravel@gmail.com,brentb@cruisestoursandtravel.com",
    "DRIP_POSTAL_ADDRESS": "2216 Sofia Dr, Lutz, FL 33558"
  }
}
