{
  "name": "phlock-celebration-at-sea",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phc",
      "database_id": "9e1af854-0dd2-480e-8040-3796d0468c5e"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "PTVacations@aol.com,dawn.turnertravel@gmail.com,Brent.beasley@cruiseplanners.com",
    "SESSION_TTL_DAYS": "30",
    "MAIL_FROM": "Parrothead Day Cruise <noreply@parrotheadscruise.com>",
    "LEAD_NOTIFY_EMAILS": "PTVacations@aol.com,dawn.turnertravel@gmail.com,Brent.beasley@cruiseplanners.com,brentb@cruiseshoppers.com"
  }
}
